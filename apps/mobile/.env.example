# Copy to apps/mobile/.env and fill in — values come from Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 1 = show demo data (persona Aina Sofea). Leave empty for real data. See lib/testMode.ts (rule 4).
EXPO_PUBLIC_TEST_MODE=1

# The web portal: a password-reset link opens there (the Vercel address once it is online).
EXPO_PUBLIC_PORTAL_URL=http://localhost:3000
