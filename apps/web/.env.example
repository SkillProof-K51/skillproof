# Copy to apps/web/.env.local and fill in — values come from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only (never NEXT_PUBLIC_): Gemini API key for Modules 2, 3, 4
GEMINI_API_KEY=

# 1 = demo data instead of Supabase, a TEST MODE strip and a switch for which account you view as
# (AGENTS.md rule 4). Leave it at 1 until Azim says a page reads real data.
NEXT_PUBLIC_TEST_MODE=1
